{
  "name": "screen-ink-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "ui:dev": "npm run dev -w @screen-ink/ui",
    "app:dev": "npm run tauri -w @screen-ink/app -- dev",
    "app:build": "npm run tauri -w @screen-ink/app -- build",
    "shortcuts:data": "node scripts/extract-shortcut-data.mjs",
    "progress": "node scripts/progress.mjs",
    "i18n": "node scripts/i18n-build.mjs",
    "i18n:check": "node scripts/i18n-build.mjs --check",
    "msix:store": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-msix.ps1 -Channel store -Verify",
    "msix:direct": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-msix.ps1 -Channel direct -EmitAppInstaller -Verify"
  },
  "engines": {
    "node": ">=22"
  }
}
