{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shookshok",
  "version": "0.2.0",
  "identifier": "com.ssamuniverse.shookshok",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 ink: http://ink.localhost; img-src 'self' data: blob: ink: http://ink.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "files": {
        "Resources/ko.lproj/InfoPlist.strings": "ko.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings"
      }
    }
  }
}
